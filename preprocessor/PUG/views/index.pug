extends ../layouts/layout.pug

block vars
    - mainPage = 'Home';

block content
    +hero(
        'One Oversight Layer.<br /> Every Vendor. Every State.',
        {
            h1: 'Mortgage Default Oversight · Nationwide Since 2010',
            pageSelectors: 'hero--home',
            alignment: 'right',
            logo: 'logo-art',
            width: '258',
            height: '123'
        }
    )

    section.cds-meta
        .container(style="max-width:780px")
            .row.text-center.justify-content-between
                -
                    const metaCDS = [
                        {
                            num: '2010',
                            text: 'Trusted Since'
                        },
                        {
                            num: '94',
                            text: 'U.S. Bankruptcy Courts'
                        },
                        {
                            num: '50+',
                            text: 'States Covered'
                        },
                        {
                            num: '8',
                            text: 'Service Lines'
                        }
                    ]

                each meta in metaCDS
                    .col-md-auto
                        h2.mb-0= meta.num
                        p= meta.text

    section.sec.img-copy
        .container(style="max-width:1100px")
            .row
                .col-md-auto
                    +imgTag('compass-pic', {ext: 'png', className: 'img-fluid'})
                .col-md
                    h2 CDS is the dedicated oversight partner for mortgage servicers and investors managing default portfolios across the country. We bring every law firm, vendor, and jurisdiction working your portfolio under one standard of accountability, consistency, and visibility.
                    p We monitor every file, enforce every SLA, and hold every vendor accountable — so you stay compliant and in control without building the infrastructure to do it yourself.
                    p We don't replace your vendors. We make them perform.
                    .cta-row.mt-4
                        each cta in ['schedule a consultation', 'explore services']
                            +cta(cta, 'orange')

    section.sec-my.challenges
        .container.container1280
            +headSec('The Challenge', 'Default Portfolios Are Getting Harder to Manage', 'Dozens of law firms. Multiple states. Evolving regulations. And the cost of building oversight in-house keeps climbing. CDS is the single layer of accountability across all of it — so you don\'t have to be.')
            -
                const challengeBox = [
                    {
                        head: 'Fragmented Vendor Networks',
                        text: 'Multiple law firms and vendors across jurisdictions with inconsistent  processes, timelines, and reporting — creating blind spots.'
                    },
                    {
                        head: 'An Unforgiving Compliance Environment',
                        text: 'OCC consent orders, CFPB enforcement actions, and GSE servicing mandates demand documentation and oversight that most servicers struggle to  maintain internally.'
                    },
                    {
                        head: 'Cost of Internal Build-Out',
                        text: 'Standing up an in-house oversight function requires dedicated staff,  technology, and institutional knowledge that takes years to develop.'
                    }
                ]

            .row
                each box, index in challengeBox
                    .col-md-4.bod-start.mt-5
                        .box.mx-auto
                            .head.d-flex.align-items-center.mb-3
                                .h2.num.mb-0.me-2.pt-2= `${String(index + 1).padStart(2, '0')}`
                                h2.text-uppercase.mb-0= box.head
                            .text
                                p= box.text

            .note.text-center.mt-5
                p That's exactly what CDS was built to solve.

    section.sec-my.what-we-do
        .img-bg
            +imgTag('what-we-do-bg')
        .container.container1024
            +headSec('What we do', 'Full-Spectrum Default Oversight', 'Eight integrated service lines covering the full default lifecycle —  available as a complete portfolio solution or individual engagements tailored to your most pressing needs.')
            -
                const whatWeDo = [
                    {
                        head: 'Foreclosure Oversight',
                        icon: true,
                        text: 'Cradle-to-grave litigation monitoring with attorney performance scorecarding, driving efficiency, compliance, and predictable outcomes across your entire attorney matrix.'
                    },
                    {
                        head: 'Bankruptcy Oversight',
                        icon: null,
                        text: 'Lorem ipsum dolor sit amet, consectetur adipisicing elit. Repellat sint nam id rerum, quidem, voluptate eligendi doloremque veritatis velit aut consectetur. Pariatur delectus consequuntur eius sunt, dolorem laudantium minima odit accusantium beatae sit impedit hic cumque.'
                    },
                    {
                        head: 'Litigation Oversight',
                        icon: null,
                        text: 'Lorem ipsum dolor sit amet, consectetur adipisicing elit. Repellat sint nam id rerum, quidem, voluptate eligendi doloremque veritatis velit aut consectetur. Pariatur delectus consequuntur eius sunt, dolorem laudantium minima odit accusantium beatae sit impedit hic cumque.'
                    },
                    {
