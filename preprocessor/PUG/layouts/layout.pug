- let siteName = 'Consolidated Default Services, LLC';
- let mainPage = null;
//- - let parentPage = null;
//- - let currentPage = null;
//- - let childCurrentPage = null;
- let pageAlias = null;

block vars

//- - let titleParts = [childCurrentPage, currentPage || pageAlias, parentPage, mainPage, siteName].filter(Boolean);
- let titleParts = [pageAlias || currentPage || mainPage, siteName].filter(Boolean);
- let pageTitle = titleParts.join(' | ');

include ../partials/head.pug
include ../partials/header.pug
include ../components/all.pug
include ../partials/footer.pug

doctype html
html(lang="en")
    +head(pageTitle)
        block head

    body
        +header

        main#main(role="main")
            block content

        +footer
            block footerScripts
