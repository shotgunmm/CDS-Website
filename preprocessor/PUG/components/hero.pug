mixin hero(h2, options = {})
    -
        const {
            h1 = null,
            pic = null,
            pageSelectors,
            alignment,
            logo,
            ext = 'svg',
            width,
            height,
            text = null,
            note = null
        } = options

        const heroPic = slugify(pic || mainPage)
        const pageName = h1 || pageAlias || mainPage
        const containerClass = alignment === 'right'
            ? 'd-flex justify-content-md-end'
            : ''

    mixin heroContent()
        .hero__container(class=containerClass)
            .hero__wrap
                if logo
                    .logo
                        +imgTag(logo, { ext, width, height })

                .copy
                    h1.text-uppercase.mb-4= pageName

                    if h2
                        h2!= h2

                    if text
                        p= text

    section.hero.shadow(
        class=pageSelectors
        class=note ? 'hero--has-note' : ''
    )
        if note
            .hero__banner
                .hero__bg-img
                    +imgTag(`hero-${heroPic}`, { className: 'w-100' })

                +heroContent()

            .hero__note.bg-white.py-3
                .copy.d-flex.align-items-center.justify-content-center
                    .icon.me-3
                    .text
                        p!= note

        else
            .hero__bg-img
                +imgTag(`hero-${heroPic}`, { className: 'w-100' })

            +heroContent()