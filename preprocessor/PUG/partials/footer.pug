include helpers.pug

mixin footer()
    - servicesLinks = ['Foreclosure Oversight', 'Bankruptcy Oversight', 'Litigation Oversight', 'Eviction Oversight']
    - companyLinks = ['About Us', 'Services', 'Contact']

    mixin linksCall(head, links)
        .col-md-auto.mb-4
            .links
                h2.text-uppercase.mb-0= head
                ul.link.nav.flex-column
                    each link in links
                        li
                            a(href=pageHref(link))= link

    footer.footer(role="contentinfo")
        .container-fluid.wide
            .row.justify-content-between
                .col-md-auto.mb-4
                    .meta-footer(style="max-width:360px")
                        .logo.mb-4
                            +imgTag('logo-footer', {ext:'svg'})
                        .meta
                            p Trusted oversight partner providing cradle-to-grave default services management for mortgage servicers and financial institutions nationwide.

                +linksCall('Services', servicesLinks)
                +linksCall('company', companyLinks)
                .col-md-auto.mb-4
                    .links
                        h2.text-uppercase.mb-0 contact
                        p #[a(href="mailto:info@cds-default.com") info@cds-default.com]#[br] #[a(href="tel:972.331.2320") 972.331.2320]#[br] #[a(href="https://www.CDS-Default.com", target="_blank") www.CDS-Default.com]
            hr

            .row.justify-content-between.py-4
                .col-md-auto
                    p © 2026 Consolidated Default Services, LLC. All rights reserved.
                .col-md-auto.link-terms
                    a(href="#") Privacy Policy
                    a(href="#") Terms of Service

    .scroll-top.d-none.d-lg-block(role="button", tabindex="0", aria-label="Scroll to top")
        svg.progress-circle.svg-content(width="100%", height="100%", viewBox="-1 -1 102 102")
            path.path(d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98")
        .icon
            svg.bi.bi-arrow-up(xmlns="http://www.w3.org/2000/svg", width="16", height="16", fill="currentColor", viewBox="0 0 16 16")
                path(fill-rule="evenodd", d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5 5.707V11.5a.5.5 0 0 0 .5.5")

    script(src="js/app.js")
    script(src="js/scrollTop.js")
    if block
        block
